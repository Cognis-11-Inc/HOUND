FROM rust:1.85-slim-bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release --locked -p hound-cli

FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN mkdir /evidence && chown 10001:10001 /evidence
COPY --from=build /build/target/release/hound /usr/local/bin/hound
COPY scripts/check_boundary.py /app/check_boundary.py
USER 10001:10001
ENTRYPOINT ["hound"]
CMD ["sniff", "--output", "/evidence/observations.jsonl"]
